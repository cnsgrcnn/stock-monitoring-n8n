      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "\nconst kayitlar = $input.all().map(item => item.json);\n\n// Duruma göre malzemeleri ayır\nconst kritik = kayitlar.filter(\n  m => m.durum === \"KRITIK STOK\"\n);\n\nconst normal = kayitlar.filter(\n  m => m.durum === \"NORMAL STOK\"\n);\n\nconst hatali = kayitlar.filter(\n  m => m.durum === \"HATALI VERI\"\n);\n\n// Eksik veya tanımsız durumları kontrol et\nif (\n  kritik.length + normal.length + hatali.length\n  !== kayitlar.length\n) {\n  throw new Error(\"Eksik veya tanimsiz durum var!\");\n}\n\n// Kritik stok mesajlarını hazırla\nconst uyarilar = kritik.map(m =>\n  `${m.malzeme_kodu}: Mevcut ${m.mevcut_stok}, Kritik ${m.kritik_seviye}`\n);\n\n// Özet raporu oluştur\nconst rapor = {\n  toplam_malzeme: kayitlar.length,\n  kritik_sayisi: kritik.length,\n  normal_sayisi: normal.length,\n  hatali_sayisi: hatali.length,\n  kritik_malzemeler: kritik.map(m => m.malzeme_kodu),\n  hatali_malzemeler: hatali.map(m => m.malzeme_kodu),\n  uyari_mesaji: uyarilar.join(\"\\n\")\n};\n\nreturn [{ json: rapor }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
